local Gait=assert(loadstring(GAIT_SRC,"=FERAL_AMBER_GAIT"))()
local total,passed=0,0
local function eq(a,b,name)
    assert(a==b,(name or "gait")..": got "..tostring(a).." expected "..tostring(b))
end
local function test(name,fn)
    total+=1
    local ok,err=pcall(fn)
    if ok then passed+=1;print("PASS "..name)
    else print("FAIL "..name.." "..tostring(err)) end
end
test("long straight with healthy stamina selects Burst",function()
    eq(Gait.select(350,4,.92),"BURST")
end)
test("long sharp turn avoids Burst and sprinting",function()
    eq(Gait.select(220,97,.9),"TROT")
end)
test("long moderate turn selects sprint instead of risky Burst",function()
    eq(Gait.select(220,37,.9),"SPRINT")
end)
test("medium travel selects sprint with adequate stamina",function()
    eq(Gait.select(90,15,.51),"SPRINT")
end)
test("very short approach uses controlled trot, no sprint",function()
    eq(Gait.select(21,0,.9),"TROT")
end)
test("no stamina never fires Burst",function()
    eq(Gait.select(1000,0,.08),"TROT")
end)
test("unknown stamina permits sprint only, not unsafe Burst",function()
    eq(Gait.select(230,0,nil),"SPRINT")
end)
test("Burst blocked by native cooldown uses normal sprint",function()
    eq(Gait.select(350,0,.91,{burstReady=false}),"SPRINT")
end)
test("ability blocks Burst and sprint temporarily",function()
    eq(Gait.select(350,0,.91,{ability=true}),"TROT")
end)
test("crowded route never bursts or sprints through players",function()
    eq(Gait.select(350,0,.91,{crowded=true}),"TROT")
end)
test("arrival margin always precedes territory claim radius",function()
    eq(Gait.arrived(10,17),true)
    eq(Gait.arrived(14,17),true)
    eq(Gait.arrived(17,17),false)
end)
test("waypoint advances only after actual proximity",function()
    local points={{x=0,z=0},{x=26,z=0},{x=52,z=0}}
    eq(Gait.waypointIndex(points,1,{x=2,z=0},10),2)
    eq(Gait.waypointIndex(points,2,{x=19,z=0},10),3)
    eq(Gait.waypointIndex(points,3,{x=19,z=0},10),3)
end)
test("moving toward a target is not falsely classified stalled",function()
    eq(Gait.progress(9,2,120,68,5,3),"ADVANCING")
    eq(Gait.progress(4,2,120,118,5,3),"MONITOR")
end)
test("no progress for repeated seconds triggers a safe replan",function()
    eq(Gait.progress(9,2,120,119,5,3),"STALLED")
end)
test("motion heading turn derived from displacement, not camera",function()
    eq(math.floor(Gait.turn({x=0,z=0},{x=12,z=0},{x=25,z=0})),0)
    eq(math.floor(Gait.turn({x=0,z=0},{x=12,z=0},{x=12,z=80})),90)
end)
test("zero / malformed navigation inputs never request Burst",function()
    eq(Gait.select(0,0,1),"STOP")
    eq(Gait.select(0/0,0,1),"STOP")
    eq(Gait.distance({x=0,z=0},{x=0/0,z=0}),math.huge)
end)
local function controller()
    local io={keys={},taps={}}
    function io:hold(key,on)self.keys[key]=on;return true end
    function io:tap(key)table.insert(self.taps,key);return true end
    local s={hudBurst=false,hudSprint=false,hudTrot=false}
    return Gait.controller(io),io,s
end
test("requested sprint is distinct from an unconfirmed observed walk",function()
    local g,io,s=controller();g:step("SPRINT",s,10)
    eq(g.requested,"SPRINT");eq(g.observed,"WALK");eq(g.confirmations,0)
end)
test("failed sprint receives bounded retries and falls back to trot",function()
    local g,io,s=controller();g:step("SPRINT",s,10);g:step("SPRINT",s,12.5);g:step("SPRINT",s,15)
    eq(g.requested,"TROT");eq(g.attempts.SPRINT,2);eq(io.keys.SHIFT,false)
end)
test("native Burst denial avoids X requests",function()
    local g,io,s=controller();s.hudBurstNo=true;g:step("BURST",s,10)
    eq(g.requested,"SPRINT");eq(#io.taps,0)
end)
test("ignored Burst toggle cannot be blindly repeated",function()
    local g,io,s=controller()
    for t=10,18 do g:step("BURST",s,t)end
    local x=0;for _,key in ipairs(io.taps)do if key=="X"then x+=1 end end
    eq(x,2);assert(g.blocked.BURST>18)
end)
test("a real HUD gait change acknowledges the outstanding request",function()
    local g,io,s=controller();g:step("SPRINT",s,10);s.hudSprint=true;g:step("SPRINT",s,10.3)
    eq(g.observed,"SPRINT");eq(g.confirmations,1);eq(g.pending,nil)
end)
test("leaving an owned active Burst uses a single confirmed toggle",function()
    local g,io,s=controller();g:step("BURST",s,10);s.hudBurst=true;g:step("BURST",s,11)
    g:step("TROT",s,14);eq(io.taps[2],"X")
    s.hudBurst=false;g:step("TROT",s,14.5)
    local count=0;for _,key in ipairs(io.taps)do if key=="X"then count+=1 end end;eq(count,2)
end)
test("gait hysteresis prevents alternating sprint and trot requests",function()
    local g,io,s=controller();g:step("SPRINT",s,10);g:step("TROT",s,10.4)
    eq(g.requested,"SPRINT");g:step("WALK",s,10.6);eq(g.requested,"WALK");eq(io.keys.SHIFT,false)
end)
test("swimming uses native swim gait without claiming unlimited Burst",function()
    eq(Gait.select(400,0,1,{swimming=true}),"TROT")
    eq(Gait.select(400,0,1,{swimming=true,swimSprint=true}),"SPRINT")
end)
test("missing gait attributes never trigger an unknown Burst toggle",function()
    local g,io,s=controller();s.hudBurst=nil;s.hudSprint=nil;s.hudTrot=nil
    g:step("BURST",s,10);eq(g.observed,"UNKNOWN");eq(g.requested,"SPRINT");eq(#io.taps,0)
end)
test("stopping leaves a pre-existing manual trot toggle untouched",function()
    local g,io,s=controller();s.hudTrot=true;g:stop(s,10);eq(#io.taps,0)
end)
test("close pursuit requests sprint when moving prey is outrunning trot",function()
    eq(Gait.select(12,10,.9,{hunting=true,preySpeed=20}),"SPRINT")
    eq(Gait.select(12,95,.9,{hunting=true,preySpeed=20}),"TROT")
end)
test("clear medium straight travel uses Burst when the native mode is available",function()
    eq(Gait.select(110,3,.98,{allowBurst=true,burstReady=true}),"BURST")
end)
test("close following chooses a native gait that can match prey speed",function()
    eq(Gait.select(14,0,1,{following=true,preySpeed=20,gaitSpeeds={WALK=12,TROT=24,SPRINT=40}}),"TROT")
end)
test("sharp-turn braking can leave high speed without waiting for mode hysteresis",function()
    local g,io,s=controller();g:step("SPRINT",s,10);s.brake=true
    g:step("TROT",s,10.2);eq(g.requested,"TROT");eq(io.keys.SHIFT,false)
end)
test("a confirmed sprint upgrades to eligible Burst immediately",function()
    local g,io,s=controller();g:step("SPRINT",s,10);s.hudSprint=true
    g:step("BURST",s,10.2);eq(g.requested,"BURST");eq(io.taps[1],"X")
end)
test("a long straight hunt uses Burst instead of being capped to sprint",function()
    eq(Gait.select(140,4,.95,{hunting=true,preySpeed=27}),"BURST")
end)
test("missing stamina can attempt guarded Burst only with a known native mode",function()
    eq(Gait.select(230,0,nil,{nativeBurstAvailable=true}),"BURST")
    eq(Gait.select(230,0,nil,{nativeBurstAvailable=false}),"SPRINT")
    eq(Gait.select(230,0,nil,{nativeBurstAvailable=true,burstReady=false}),"SPRINT")
end)
print(string.format("AMBER_GAIT_RESULT total=%d passed=%d failed=%d",total,passed,total-passed))
assert(total==passed,"Gait test failure")
