                        local points={}
                        for _,p in ipairs(path:GetWaypoints()) do
                            if typeof(p.Position)=="Vector3" and flat(p.Position,from)>2 then table.insert(points,p.Position) end
                        end
                        if #points>0 then return points,"PATH_SURFACE" end
                    end
                end
            end
